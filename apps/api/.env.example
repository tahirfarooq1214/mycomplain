# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/mycomplain"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="30d"

# Server
PORT=3000
NODE_ENV=development

# SMS Gateway (for OTP)
SMS_API_KEY="your-sms-api-key"
SMS_SENDER_ID="MyComplain"

# Email (for brand complaint routing)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="mycomplain.service@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="MyComplain Service <mycomplain.service@gmail.com>"

# WhatsApp Business API
WHATSAPP_API_URL="https://graph.facebook.com/v18.0"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"

# File Upload (S3 / Cloudflare R2)
S3_BUCKET="mycomplain-uploads"
S3_REGION="ap-south-1"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID="mycomplain-app"
FIREBASE_PRIVATE_KEY="your-firebase-key"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@mycomplain-app.iam.gserviceaccount.com"
